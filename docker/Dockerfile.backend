FROM ghcr.io/astral-sh/uv:0.12.11@sha256:79c6f4776b851471cc73b7d21d0cc834bb94383c292e83640d27eff512864df7 AS uv
FROM docker.io/library/python:3.12-slim-trixie@sha256:78387bc3881b8273120a12ebe6c1ab22b018ccc2c9adf565ae1ac9b536e184ea AS builder
COPY --from=uv /uv /bin/uv

# UV_PYTHON_DOWNLOADS=0: always use the image's interpreter, never fetch a
# managed Python (airgap-first).
ENV UV_PYTHON_DOWNLOADS=0 \
    UV_CACHE_DIR=/root/.cache/uv \
    UV_COMPILE_BYTECODE=1 \
    UV_LINK_MODE=copy \
    UV_PROJECT_ENVIRONMENT=/app/.venv

WORKDIR /app

# Install runtime deps without the project, to maximize cache reuse.
RUN --mount=type=cache,target=/root/.cache/uv \
    --mount=type=bind,source=uv.lock,target=uv.lock \
    --mount=type=bind,source=pyproject.toml,target=pyproject.toml \
    uv sync --locked --no-dev --no-install-project

# Copy source and install the project itself.
COPY chorus /app/chorus
COPY pyproject.toml uv.lock README.md /app/
RUN --mount=type=cache,target=/root/.cache/uv \
    uv sync --locked --no-dev

# Runtime stage — slim, no toolchain.
FROM docker.io/library/python:3.12-slim-trixie@sha256:78387bc3881b8273120a12ebe6c1ab22b018ccc2c9adf565ae1ac9b536e184ea
ENV PYTHONUNBUFFERED=1 \
    VIRTUAL_ENV=/app/.venv \
    PATH="/app/.venv/bin:${PATH}" \
    UV_PROJECT_ENVIRONMENT=/app/.venv

# Non-root runtime user (deploy ADR 0001). /app stays root-owned and
# read-only to the app user; all runtime writes land under CHORUS_HOME
# (the chorus-state volume).
RUN groupadd --gid 10001 app \
    && useradd --uid 10001 --gid app --create-home --home-dir /home/app \
       --shell /usr/sbin/nologin app
ENV HOME=/home/app

WORKDIR /app
COPY --from=builder /app /app

USER 10001:10001

EXPOSE 8000

CMD ["uvicorn", "chorus.api.main:app", "--host", "0.0.0.0", "--port", "8000"]
